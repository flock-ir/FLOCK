{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flock-cloudflare-connector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "CloudflareConnectorAgent",
        "class_name": "CloudflareConnectorAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CloudflareConnectorAgent"]
    }
  ]
}
