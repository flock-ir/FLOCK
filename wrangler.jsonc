{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flock",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flock-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
